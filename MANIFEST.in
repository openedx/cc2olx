include LICENSE
include README.rst

recursive-include src/cc2olx/templates *
recursive-include tests *
prune test_data
prune .github
exclude uv.lock Dockerfile .dockerignore .editorconfig .gitignore codecov.yml
recursive-exclude * __pycache__
recursive-exclude * *.py[co]

recursive-include *.rst Makefile *.jpg *.png *.gif
